---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<BaseLayout title="Contact | Prateek Gupta">

<SectionTitle title="Contact" eyebrow="Get in touch" />

<div class="card" style="max-width:520px; display:flex; flex-direction:column; gap:18px;">

  <!-- Phone -->
  <p style="display:flex; align-items:center; gap:12px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3.1 4.18 
               2 2 0 0 1 5.11 2h3a2 2 0 0 1 2 1.72 
               12.84 12.84 0 0 0 .7 2.81 
               2 2 0 0 1-.45 2.11L9.2 9.2
               a16 16 0 0 0 6.6 6.6l.56-.56
               a2 2 0 0 1 2.11-.45 
               12.84 12.84 0 0 0 2.81.7 
               2 2 0 0 1 1.72 2z"/>
    </svg>
    <a href="tel:+916378861223" style="font-weight:600; color:var(--accent-strong);">
      6378861223
    </a>
  </p>

  <!-- Email -->
  <p style="display:flex; align-items:center; gap:12px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4
               c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
      <polyline points="22,6 12,13 2,6"/>
    </svg>
    <a href="mailto:prateek.gupta@kgpian.iitkgp.ac.in" style="font-weight:600; color:var(--accent-strong);">
      Email Me
    </a>
  </p>

  <!-- LinkedIn -->
  <p style="display:flex; align-items:center; gap:12px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8a6 6 0 0 1 6 6v7"/>
      <rect x="2" y="9" width="4" height="12" rx="1"/>
      <circle cx="4" cy="4" r="2"/>
      <path d="M8 21v-7a6 6 0 0 1 12 0"/>
    </svg>
    <a href="https://www.linkedin.com/in/prateek-gupta-631573254" target="_blank"
       style="font-weight:600; color:var(--accent-strong);">
      LinkedIn Profile
    </a>
  </p>

  <!-- GitHub -->
  <p style="display:flex; align-items:center; gap:12px;">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87
               a3.37 3.37 0 0 0-.94-2.61
               c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77
               A5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 
               13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1
               A5.07 5.07 0 0 0 5 4.77
               5.44 5.44 0 0 0 3.5 8.5
               c0 5.42 3.3 6.61 6.44 7
               a3.37 3.37 0 0 0-.94 2.6V22"/>
    </svg>
    <a href="https://github.com/prateek-g-bit" target="_blank"
       style="font-weight:600; color:var(--accent-strong);">
      GitHub Profile
    </a>
  </p>

</div>



</BaseLayout>
